# ── Environment ───────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev default — chemin absolu ou relatif au dossier backend/)
DATABASE_PATH=/app/padel_stats.db

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Dev: http://localhost:5173
# Prod: https://padel-stats.fr (remplacer par votre domaine)
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# ── JWT ──────────────────────────────────────────────────────────────────────
# OBLIGATOIRE en production : générer avec `openssl rand -hex 32`
SECRET_KEY=change-me-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── GitHub sync ──────────────────────────────────────────────────────────────
# Requis en production pour que le bouton "Import donnees" persiste les mois
# importes (sinon ils ne survivent pas a un redemarrage a froid de la fonction
# serverless). Token fine-grained avec acces "Contents: Read and write" sur ce repo.
GITHUB_TOKEN=
GITHUB_REPO=AlexandruCodeP/padel-stats
GITHUB_DB_PATH=backend/padel_stats.db.zst
GITHUB_BRANCH=master
